---
import BaseLayout from '../layouts/BaseLayout.astro'

const githubUrl = 'https://github.com/thewelshrich/schooner'
const installUrl = '/docs/installation/'
const docsUrl = '/docs/'
---

<BaseLayout
  title="Schooner — Persistent remote dev machines you actually own"
  description="An open-source CLI that connects SSH, Git worktrees, and tmux into one resumable remote development workflow. No account required."
>
  <div class="site-shell">
    <div class="background-media" aria-hidden="true">
      <img src="/hero_ocean-poster.jpg" alt="" />
      <video
        data-ocean-source
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        poster="/hero_ocean-poster.jpg"
      >
        <source src="/hero_ocean.mp4" type="video/mp4" />
      </video>
      <canvas class="ocean-dither" data-ocean-dither></canvas>
      <div class="background-wash"></div>
      <div class="background-vignette"></div>
    </div>

    <header class="site-header">
      <a class="brand" href="/" aria-label="Schooner home">
        <img src="/schooner-mark.png" alt="" width="32" height="32" />
        <span>Schooner</span>
      </a>

      <nav class="site-nav" aria-label="Primary navigation">
        <a href={docsUrl}>Docs</a>
        <a href={`${githubUrl}/blob/main/docs/roadmap.md`}>Roadmap</a>
        <a class="github-link" href={githubUrl} aria-label="Schooner on GitHub">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.57-.3-5.27-1.29-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.97 10.97 0 0 1 5.75 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.71 5.39-5.29 5.68.42.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"
            ></path>
          </svg>
          <span class="github-label">GitHub</span>
          <span class="star-count" data-star-count aria-label="GitHub stars">Star</span>
        </a>
      </nav>
    </header>

    <main>
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero-copy">
        <h1 id="hero-heading">Persistent remote dev machines<br />you actually own.</h1>
        <p>
          Schooner is an open-source CLI that connects SSH, Git worktrees, and
          tmux into one resumable workflow — so your sessions survive a closed
          laptop and your machines stay yours.
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="#install">
            Install Schooner
            <span aria-hidden="true">→</span>
          </a>
          <a class="button button-secondary" href={githubUrl}>
            View on GitHub
          </a>
        </div>

        <ul class="trust-points" aria-label="Schooner product principles">
          <li>No account required</li>
          <li>No hosted control plane</li>
          <li>Ordinary SSH always works</li>
          <li><a href={`${githubUrl}/blob/main/LICENSE`}>Apache 2.0</a></li>
        </ul>
      </div>

      <section class="install-panel" id="install" tabindex="-1" aria-labelledby="install-heading">
        <div class="install-header">
          <h2 id="install-heading">Install from your terminal</h2>
          <div class="install-tabs" role="group" aria-label="Installation method">
            <button type="button" aria-pressed="true" data-install-method
              data-command="brew install thewelshrich/tap/schooner">Homebrew</button>
            <button type="button" aria-pressed="false" data-install-method
              data-command="curl -fsSL https://raw.githubusercontent.com/thewelshrich/schooner/main/scripts/install.sh | bash">Installer script</button>
          </div>
        </div>
        <div class="command-row">
          <span class="prompt" aria-hidden="true">$</span>
          <code data-command-output>brew install thewelshrich/tap/schooner</code>
          <button class="copy-button" type="button" aria-label="Copy install command">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="9" y="9" width="11" height="11" rx="2"></rect>
              <path d="M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3"></path>
            </svg>
          </button>

        </div>
        <div class="install-meta">
          <p>macOS 13+ &amp; Linux · amd64 / arm64</p>
          <a href={installUrl}>Installation guide <span aria-hidden="true">↗</span></a>
        </div>
        <p class="copy-status" role="status" aria-live="polite"></p>
      </section>
    </section>

    <section class="workflow" aria-labelledby="workflow-heading">
      <div class="workflow-copy">
        <h2 id="workflow-heading">Close your laptop.<br />Pick up where you left off.</h2>
        <p>Connect an Ubuntu machine you already reach over SSH. Send your checkout, start a tmux session, and return to it later.</p>
        <p class="workflow-note">The guided setup connects your SSH machine. Run the work commands from your local checkout; Schooner remembers where you work.</p>
        <a class="text-link" href="/docs/first-session/">Walk through the quick start <span aria-hidden="true">→</span></a>
      </div>
      <pre class="workflow-terminal" aria-label="Example remote development workflow"><code><span class="code-comment"># Connect your machine with guided setup</span>
schooner box add

<span class="code-comment"># Send your checkout and start working</span>
cd repository
schooner push
schooner start

<span class="code-comment"># Come back to your session later</span>
schooner resume</code></pre>
    </section>
    </main>

    <footer class="site-footer">
      <p>Open source. Built for developers who keep their own keys.</p>
      <nav aria-label="Footer navigation">
        <a href={`${githubUrl}/blob/main/LICENSE`}>License</a>
        <a href={`${githubUrl}/blob/main/SECURITY.md`}>Security</a>
        <a href={`${githubUrl}/blob/main/CONTRIBUTING.md`}>Contribute</a>
      </nav>
    </footer>
  </div>

  <script>
    import { initializeOceanDither } from '../scripts/ocean-dither'

    initializeOceanDither()

    const repositoryApi = 'https://api.github.com/repos/thewelshrich/schooner'
    const starNodes = document.querySelectorAll<HTMLElement>('[data-star-count]')

    function formatStars(count: number) {
      if (count < 1000) return String(count)
      return new Intl.NumberFormat('en', {
        notation: 'compact',
        maximumFractionDigits: 1,
      }).format(count)
    }

    async function updateStarCount() {
      try {
        const cached = sessionStorage.getItem('schooner-stars')
        if (cached) {
          const { count, savedAt } = JSON.parse(cached)
          if (Date.now() - savedAt < 10 * 60 * 1000) {
            starNodes.forEach((node) => (node.textContent = formatStars(count)))
            return
          }
        }

        const response = await fetch(repositoryApi, {
          headers: { Accept: 'application/vnd.github+json' },
        })
        if (!response.ok) return

        const repository = await response.json()
        const count = repository.stargazers_count
        if (typeof count !== 'number') return

        sessionStorage.setItem('schooner-stars', JSON.stringify({ count, savedAt: Date.now() }))
        starNodes.forEach((node) => (node.textContent = formatStars(count)))
      } catch {
        // The GitHub link remains useful if the public API is unavailable.
      }
    }

    void updateStarCount()

    const methods = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-install-method]'))
    const commandOutput = document.querySelector<HTMLElement>('[data-command-output]')
    const copyButton = document.querySelector<HTMLButtonElement>('.copy-button')
    const copyStatus = document.querySelector<HTMLElement>('.copy-status')
    let copyTimer: number | undefined

    document.querySelector<HTMLAnchorElement>('a[href="#install"]')?.addEventListener('click', () => {
      document.querySelector<HTMLElement>('#install')?.focus({ preventScroll: true })
    })

    methods.forEach((method) => {
      method.addEventListener('click', () => {
        methods.forEach((item) => item.setAttribute('aria-pressed', String(item === method)))
        if (commandOutput) commandOutput.textContent = method.dataset.command ?? ''
        window.clearTimeout(copyTimer)
        if (copyStatus) copyStatus.textContent = ''
      })
    })

    copyButton?.addEventListener('click', async () => {
      const command = commandOutput?.textContent ?? ''
      if (!command) return

      try {
        await navigator.clipboard.writeText(command)
        window.clearTimeout(copyTimer)
        if (copyStatus) copyStatus.textContent = 'Copied to clipboard'
        copyTimer = window.setTimeout(() => {
          if (copyStatus) copyStatus.textContent = ''
        }, 1800)
      } catch {
        if (copyStatus) copyStatus.textContent = 'Select the command to copy'
      }
    })

  </script>
</BaseLayout>
